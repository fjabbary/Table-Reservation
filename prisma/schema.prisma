// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum TableLocation {
  INDOOR
  PATIO
  BAR
  PRIVATE_DINING
}

model Table {
  id          String   @id @default(cuid())
  name        String
  capacity    Int
  location    TableLocation
  description String?
  // Comma-separated list, e.g. "Window View,Private Area" (SQLite has no native array type)
  features    String?
  policies    String?
  imageUrl    String?
  createdAt   DateTime @default(now())

  reservations Reservation[]
}

model Reservation {
  id              String   @id @default(cuid())
  referenceNumber String   @unique

  tableId String
  table   Table  @relation(fields: [tableId], references: [id])

  // Start of the reservation window; duration is a fixed app-level constant (see lib/constants.ts)
  startTime DateTime
  partySize Int

  guestName       String
  guestEmail      String
  guestPhone      String
  specialRequests String?

  createdAt DateTime @default(now())

  @@index([tableId, startTime])
}
